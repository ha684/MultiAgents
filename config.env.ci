# CI/CD Environment Configuration
# This file contains dummy/mock values for testing purposes in GitHub Actions

# Environment
ENVIRONMENT=test

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_kms_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_kms_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URI=redis://localhost:6379/0

# Vector Storage (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
VECTOR_STORAGE_URL=localhost:6333
VECTOR_COLLECTION_NAME=kms_vector_store

# MinIO (Object Storage) - Mock values
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=test_access_key
MINIO_SECRET_KEY=test_secret_key
MINIO_BUCKET=test-bucket
MINIO_SECURE=false

# JWT Configuration
JWT_SECRET_KEY=test_secret_key_for_ci
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ReRank API - Mock values
RERANK_URL=http://localhost:8001
RERANK_API_KEY=test_rerank_key
RERANK_MODEL=nx-text-rerank-001

# Text Embedding - Mock values
TEXT_EMBEDDING_URL=http://localhost:8002
TEXT_EMBEDDING_API_KEY=test_embedding_key
TEXT_EMBEDDING_MODEL=test-embedding-model
EMBEDDING_DIMENSIONS=1024

# NTQAI - Mock values
NTQAI_BASE_URL=http://localhost:8003
NTQAI_API_KEY=test_ntqai_key
NTQAI_MODEL=test-ntqai-model

# Neo4j - Mock values
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Web Search - Disabled for tests
ENABLE_WEBSEARCH=false

# Rate Limiting
RATE_LIMIT_REQUESTS=2000
RATE_LIMIT_WINDOW_MINUTES=1
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
SESSION_EXPIRE_HOURS=24

# OAuth - Optional (not needed for basic tests)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# CORS
CORS_ALLOW_CREDENTIALS=true

# Email/Password Reset
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# Server
PORT=8000

# Frontend
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_URL=http://localhost:8000/auth/oauth/callback

# Cache
CACHE_DIR=./.cache

# Celery
CELERY_WORKER_NUM=3

