# Database configuration
DATABASE_URL=postgresql://kms_user:kms_password@localhost:5432/kms_db

# Redis configuration
REDIS_URI=redis://localhost:6379/0

# Qdrant (Vector Database) configuration
VECTOR_STORAGE_URL=localhost:6333

# Application configuration
PORT=8000

# MinIO configuration
MINIO_ENDPOINT=minio.ntq.ai
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=kms-dev
MINIO_SECURE=true

# ReRank API configuration
RERANK_URL=
RERANK_API_KEY=

# Text Embedding configuration
TEXT_EMBEDDING_URL=
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_MODEL=nx-embed-multi

# Docker compose specific settings
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
DATABASE_PORT=5432
REDIS_PORT=6379

GOOGLE_API_KEY=
GOOGLE_API_MODEL=